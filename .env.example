PORT=3060
BASE_PATH=/file-transfer
AUTH_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-hex-string
DATABASE_URL=postgres://file_transfer:PASSWORD@127.0.0.1:5432/file_transfer
STORAGE_DIR=/var/lib/file-transfer/storage
MAX_UPLOAD_BYTES=21474836480
NODE_ENV=production
TRUST_PROXY=1

# Runtime tuning
SESSION_DAYS=14
UPLOAD_GC_HOURS=24
CLEANUP_INTERVAL_MINUTES=3

# Frontend build-time tuning (Vite)
VITE_CHUNK_SIZE=8388608
VITE_UPLOAD_CONCURRENCY=4
VITE_MAX_UPLOAD_BYTES=21474836480

# Optional backend upload-session default
CHUNK_SIZE=8388608
UPLOAD_CONCURRENCY=4
